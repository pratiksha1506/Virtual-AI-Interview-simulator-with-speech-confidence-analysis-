# AI Interview Simulator - Environment Configuration
# Copy this file to .env and configure your credentials.

# Application Server
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
SESSION_SECRET=super_secret_interview_key_change_in_production

# Real AI / LLM Providers (Optional - local fallback used if not provided)
# Provide one of the keys below to enable live LLM question & evaluation generation:
GEMINI_API_KEY=key
OPENAI_API_KEY=key
# Preferred AI Model
# For Gemini: gemini-flash-lite-latest or gemini-3.5-flash
# For OpenAI: gpt-4o-mini or gpt-4o
LLM_MODEL=gemini-flash-lite-latest
